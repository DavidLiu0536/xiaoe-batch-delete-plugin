{
  "manifest_version": 3,
  "name": "小鹅通考试批量管理工具",
  "version": "1.0.0",
  "description": "批量处理小鹅通考试重复副本，支持重复检测、关联替换、批量删除",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://admin.xiaoe-tech.com/*",
    "https://api.xiaoe-tech.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://admin.xiaoe-tech.com/t/exam/examination*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}